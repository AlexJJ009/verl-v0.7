# Copy to handoff.env on the Meituan client. This file is machine-local and
# must not contain credentials.
HANDOFF_ACTION=render
ROOT=/absolute/Meituan/root
HANDOFF_BUNDLE_ROOT=/absolute/Meituan/root/verl-exp/receipts/rebuttal_rlvr/handoff

# The registered R01 delivery slot. The manifest must bind this exact model and
# its checkpoint receipt before pilot/formal submission.
R01_MODEL_NAME=R01_ORDINARY_SFT_4B_AM1P4M
R01_MODEL_PATH=/absolute/Meituan/root/models/rebuttal_rlvr/init/R01_ORDINARY_SFT_4B_AM1P4M

# Required only when HANDOFF_ACTION=submit. G3 is produced on Meituan; G4 is
# already bound inside every pilot/formal manifest row.
# All G3/G4/manifest paths are derived from HANDOFF_BUNDLE_ROOT. Override an
# individual path only when the reviewed bundle layout itself was amended.
MAX_ACTIVE_JOBS=8
