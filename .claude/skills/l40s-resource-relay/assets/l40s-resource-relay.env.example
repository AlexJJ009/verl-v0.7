# Copy to ~/.config/verl/l40s-resource-relay.env and chmod 600.
# Never commit the populated file. Environment variables override this file.
L40S_RELAY_HOST=REPLACE_WITH_PRIVATE_NUMERIC_IP
L40S_RELAY_PORT=REPLACE_WITH_SSH_PORT
L40S_RELAY_USER=REPLACE_WITH_RESTRICTED_USER
L40S_RELAY_STAGING_ROOT=REPLACE_WITH_ABSOLUTE_STAGING_ROOT
L40S_RELAY_IDENTITY_FILE=REPLACE_WITH_ABSOLUTE_PRIVATE_KEY_PATH
L40S_RELAY_KNOWN_HOSTS_FILE=REPLACE_WITH_ABSOLUTE_KNOWN_HOSTS_PATH
L40S_RELAY_RECEIPT_ROOT=/data-1/model_weights/logs/l40s-resource-relay
