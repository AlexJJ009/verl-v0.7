#!/usr/bin/env bash
set -euo pipefail

# GON-35's Recipe worker creates host-visible paths before crossing the
# verl-dev-run boundary. Translate only those admitted mutable paths to the
# existing /data-1/outputs mount; all other launcher behavior stays native.
: "${GON35_HOST_OUTPUT_ROOT:?GON-35 host output root is required}"
: "${GON35_CONTAINER_OUTPUT_ROOT:?GON-35 container output root is required}"

launcher=${VERL_DEV_RUN_REAL:-/data_storage/yl_test/lgx/home/.local/bin/verl-dev-run}
[[ -x "${launcher}" ]] || { echo "ERROR: real verl-dev-run is unavailable: ${launcher}" >&2; exit 69; }
: "${GRPO_EXPECTED_LAUNCHER_SHA256:?admitted machine-launcher checksum is required}"
actual_launcher_sha256=$(sha256sum -- "${launcher}" | awk '{print $1}')
[[ "${actual_launcher_sha256}" == "${GRPO_EXPECTED_LAUNCHER_SHA256}" ]] || {
  echo "ERROR: real verl-dev-run bytes drifted after GON-35 admission" >&2
  exit 78
}
[[ "${GON35_HOST_OUTPUT_ROOT}" == /data_storage/yl_test/lgx/artifacts/verl/outputs/* ]] || {
  echo "ERROR: GON-35 host output root escaped the admitted artifact namespace" >&2
  exit 64
}
[[ "${GON35_CONTAINER_OUTPUT_ROOT}" == /data-1/outputs/* ]] || {
  echo "ERROR: GON-35 container output root escaped the launcher output mount" >&2
  exit 64
}

translate_output_path() {
  local name=$1 value suffix
  value=${!name-}
  [[ -n "${value}" ]] || { echo "ERROR: ${name} is required at the GON-35 launcher boundary" >&2; exit 64; }
  case "${value}/" in
    "${GON35_HOST_OUTPUT_ROOT}/"*)
      suffix=${value#"${GON35_HOST_OUTPUT_ROOT}"}
      printf -v "${name}" '%s' "${GON35_CONTAINER_OUTPUT_ROOT}${suffix}"
      export "${name}"
      ;;
    *)
      echo "ERROR: ${name} escaped the admitted GON-35 output root: ${value}" >&2
      exit 64
      ;;
  esac
}

for variable in BASE_CKPT_DIR LOG_DIR WANDB_DIR GRPO_ADMISSION_RECEIPT; do
  translate_output_path "${variable}"
done

exec "${launcher}" --no-code-overlay "$@"
